{
  "name": "dsh-sidebar-compact",
  "version": "0.1.3",
  "description": "DSH 插件「侧栏收纳」：侧栏只保留勾选的入口，其余全局面板收进「更多」菜单。",
  "type": "module",
  "license": "MIT",
  "author": "Y77H",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "sidebar",
    "layout",
    "more-menu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doraasn/dsh-sidebar-compact.git"
  },
  "homepage": "https://github.com/doraasn/dsh-sidebar-compact#readme",
  "bugs": {
    "url": "https://github.com/doraasn/dsh-sidebar-compact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
